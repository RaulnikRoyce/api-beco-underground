PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=beco_underground
DB_PORT=3306

# Obrigatório. O boot exige JWT_SECRET.
JWT_SECRET=defina-uma-chave-longa-e-aleatoria
# Na Aiven, use DB_SSL=true. Host *.aivencloud.com também liga SSL sozinho.
# DB_SSL=true
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Obrigatórios apenas para `npm run seed:admin`. Use senha única com 12+ caracteres.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Checkout Pro. Access Token só no servidor. Teste começa com TEST-. Produção começa com APP_USR-.
# Sem este valor a loja lista eventos e responde 503 no pagamento.
MP_ACCESS_TOKEN=

# URL da loja (back_urls). O Mercado Pago recusa localhost e HTTP. Em produção use HTTPS público.
# Local, http://localhost:5174. A API omite auto_return nesse caso.
LOJA_INGRESSOS_URL=http://localhost:5174

# URL da API (notification_url do webhook). Em localhost o Mercado Pago não entrega o aviso.
# Produção, https://api-beco-underground.onrender.com
API_PUBLIC_URL=http://localhost:3000

# Opcionais. Sem valor, o código usa 4 ingressos por pedido, 4 por e-mail e reserva de 15 minutos.
# INGRESSOS_MAX_POR_PEDIDO=4
# INGRESSOS_MAX_POR_EMAIL=4
# INGRESSOS_RESERVA_MIN=15
