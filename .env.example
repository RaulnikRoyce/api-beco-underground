PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=beco_underground
DB_PORT=3306

# Obrigatório. O boot exige JWT_SECRET.
JWT_SECRET=defina-uma-chave-longa-e-aleatoria
# Na Aiven, use DB_SSL=true. Host *.aivencloud.com também liga SSL sozinho.
# DB_SSL=true
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Obrigatório para seed:admin. Defina credenciais únicas e seguras.
# SEED_ADMIN_EMAIL=seu-email-unico@exemplo.com
# SEED_ADMIN_PASSWORD=sua-senha-forte-e-aleatoria
