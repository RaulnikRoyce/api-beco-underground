{
  "openapi": "3.0.3",
  "info": {
    "title": "API Beco Underground",
    "version": "1.0.0",
    "description": "Painel interno de produção, eventos, artistas, lineup e cachê."
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "Local" },
    { "url": "https://api-beco-underground.onrender.com", "description": "Produção" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "Erro": {
        "type": "object",
        "properties": {
          "erro": { "type": "string" },
          "detalhes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "campo": { "type": "string" },
                "mensagem": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/logo-beco.png": {
      "get": {
        "security": [],
        "summary": "Logo PNG do Beco Underground",
        "responses": {
          "200": { "description": "image/png" }
        }
      }
    },
    "/health": {
      "get": {
        "security": [],
        "summary": "Saúde da API e do MySQL",
        "responses": {
          "200": { "description": "{ status: ok } (processo e banco)" },
          "503": { "description": "Banco indisponível" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "security": [],
        "summary": "Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "senha"],
                "properties": {
                  "email": { "type": "string" },
                  "senha": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "{ mensagem, token, perfil, email, id }" },
          "401": { "description": "Credenciais inválidas" }
        }
      }
    },
    "/auth/registrar": {
      "post": {
        "security": [],
        "summary": "Cadastrar produtor (público)",
        "responses": {
          "201": { "description": "Conta de produtor criada" },
          "409": { "description": "E-mail já cadastrado" }
        }
      }
    },
    "/auth/senha": {
      "patch": {
        "summary": "Trocar a própria senha (logado; exige senha atual)",
        "responses": {
          "200": { "description": "Senha atualizada" },
          "403": { "description": "Senha atual incorreta" }
        }
      }
    },
    "/auth/usuarios": {
      "get": {
        "summary": "Listar usuários (admin)",
        "responses": { "200": { "description": "Array { id, email, perfil, ativo }" } }
      }
    },
    "/auth/usuarios/{id}": {
      "patch": {
        "summary": "Ativar ou desativar usuário (admin)",
        "responses": { "200": { "description": "{ mensagem, usuario }" } }
      },
      "delete": {
        "summary": "Excluir usuário (admin)",
        "responses": { "200": { "description": "Usuário excluído" } }
      }
    },
    "/auth/usuarios/{id}/senha": {
      "patch": {
        "summary": "Redefinir senha de outro usuário (admin)",
        "responses": {
          "200": { "description": "Senha redefinida" },
          "403": { "description": "A própria conta usa PATCH /auth/senha" }
        }
      }
    },
    "/eventos": {
      "get": {
        "summary": "Listar eventos",
        "parameters": [
          { "name": "include", "in": "query", "schema": { "enum": ["lineup"] } },
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "ordenar", "in": "query", "schema": { "enum": ["data_desc", "data_asc", "nome"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Array de eventos, ou envelope { dados, meta } se page for enviado" } }
      },
      "post": {
        "summary": "Criar evento",
        "responses": { "201": { "description": "Evento criado" } }
      }
    },
    "/eventos/{id}": {
      "get": { "summary": "Obter evento", "responses": { "200": { "description": "Evento" } } },
      "patch": { "summary": "Editar evento (dono ou admin)", "responses": { "200": { "description": "Evento atualizado" } } },
      "delete": { "summary": "Excluir evento (dono ou admin)", "responses": { "200": { "description": "Evento excluído" } } }
    },
    "/bandas": {
      "get": { "summary": "Listar artistas", "responses": { "200": { "description": "Array de bandas" } } },
      "post": { "summary": "Cadastrar artista (admin)", "responses": { "201": { "description": "Banda cadastrada" } } }
    },
    "/bandas/{id}": {
      "get": { "summary": "Obter artista", "responses": { "200": { "description": "Banda" } } },
      "delete": { "summary": "Excluir artista (admin)", "responses": { "200": { "description": "Banda excluída" } } }
    },
    "/publico/{token}": {
      "get": {
        "security": [],
        "summary": "Página da banda com evento, horário e cachê dela (sem login)",
        "parameters": [
          { "name": "token", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "{ evento, voce, lineup } (lineup sem cachê das outras)" },
          "404": { "description": "Link inválido" }
        }
      }
    },
    "/lineup": {
      "post": { "summary": "Escalar artista (admin)", "responses": { "201": { "description": "Artista escalado" } } }
    },
    "/lineup/{id}": {
      "get": { "summary": "Lineup do evento (id = evento_id)", "responses": { "200": { "description": "Array com nome, horario, cache, lineup_id" } } },
      "patch": { "summary": "Alterar horário/cachê da escalação (admin, id = lineup_id)", "responses": { "200": { "description": "Slot atualizado" } } },
      "delete": { "summary": "Tirar artista da lineup (admin, id = lineup_id)", "responses": { "200": { "description": "Removido" } } }
    },
    "/dashboard/{evento_id}": {
      "get": { "summary": "Resumo de custo (admin)", "responses": { "200": { "description": "{ total_bandas, custo_total_caches, atracoes }" } } }
    }
  }
}
