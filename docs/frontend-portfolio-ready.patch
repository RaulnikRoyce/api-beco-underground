+    window.removeEventListener('beco:unauthorized', this.aoUnauthorized);
   },
   methods: {
-    // EVENTOS
+    aoUnauthorized() {
+      this.autenticado = false;
+      this.perfil = '';
+      this.eventos = [];
+      this.bandas = [];
+      this.lineups = {};
+    },
+    async fazerLogin() {
+      this.loginErro = '';
+      this.loginCarregando = true;
+      try {
+        const { data } = await api.post('/auth/login', {
+          email: this.loginForm.email,
+          senha: this.loginForm.senha
+        });
+        localStorage.setItem('token_beco', data.token);
+        if (data.perfil) {
+          localStorage.setItem('perfil_beco', data.perfil);
+          this.perfil = data.perfil;
+        }
+        this.autenticado = true;
+        this.loginForm = { email: '', senha: '' };
+        await this.carregarPainel();
+      } catch (err) {
+        this.loginErro = err.response?.data?.erro || 'Falha no login. Verifique e-mail e senha.';
+      } finally {
+        this.loginCarregando = false;
+      }
+    },
+    sair() {
+      localStorage.removeItem('token_beco');
+      localStorage.removeItem('perfil_beco');
+      this.aoUnauthorized();
+    },
+    async carregarPainel() {
+      await Promise.all([this.buscarEventos(), this.buscarBandas()]);
+    },
+    formatarData(data) {
+      if (!data) return '';
+      return new Date(data).toLocaleDateString('pt-BR');
+    },
+    mostrarErroApi(err, fallback = 'Erro ao processar a requisição.') {
+      if (err.response?.data?.detalhes) {
+        const msgs = err.response.data.detalhes.map((d) => d.mensagem).join('\n');
+        alert(`Erro na validação:\n${msgs}`);
+        return;
+      }
+      if (err.response?.status === 403) {
+        alert('Acesso negado: é necessário perfil administrador.');
+        return;
+      }
+      alert(err.response?.data?.erro || fallback);
+    },
+
