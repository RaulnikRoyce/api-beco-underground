{
  "name": "api-beco-underground",
  "version": "1.0.0",
  "private": true,
  "description": "API REST Beco Underground",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "seed:admin": "node scripts/seed_admin.js",
    "import:schema": "node scripts/import-schema.js",
    "migrate": "node scripts/migrate.js",
    "job:expirar-reservas": "node src/jobs/expirar-reservas.js",
    "test": "node --require ./tests/setup-env.cjs --test --test-concurrency=1 ./tests/auth.middleware.test.js ./tests/evento.service.test.js ./tests/ingresso.service.test.js ./tests/mysql-datetime.test.js ./tests/pedido.schema.test.js ./tests/usuario.regras.test.js ./tests/publico.regras.test.js ./tests/publico.test.js ./tests/jwt.test.js ./tests/health.test.js ./tests/env.test.js",
    "lint": "eslint src tests server.js",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" server.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.22.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "prettier": "^3.6.2"
  }
}
